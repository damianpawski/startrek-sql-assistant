# Copy this file to .env and adjust before running `docker compose up`.
# .env is loaded automatically by Docker Compose and should not be committed.

# SQL Server sa password. Must satisfy SQL Server's complexity rules
# (8+ chars, upper + lower + digit + symbol).
MSSQL_SA_PASSWORD=YourStrong!Passw0rd

# Host port to publish SQL Server on, for connecting SSMS/Azure Data Studio
# from outside Docker. Change it if something else already owns 1433 on the
# host (another SQL container, LocalDB, SQL Express). Container-internal
# traffic always uses 1433 regardless.
#MSSQL_HOST_PORT=1433

# Any Ollama model that supports tool calling. llama3.1 is a safe default;
# see https://ollama.com/search?c=tools for other options.
# Pull it on the host first: `ollama pull llama3.1`.
OLLAMA_MODEL=llama3.1

# ---------------------------------------------------------------------------
# Which model answers questions: Ollama (local, default), OpenAI, or Anthropic.
# Only the selected provider's settings are read.
# ---------------------------------------------------------------------------
MODEL_PROVIDER=OpenAI

# Used when MODEL_PROVIDER=OpenAI. Any tool-calling-capable model.
#OPENAI_API_KEY=sk-...
#OPENAI_MODEL=gpt-4o-mini

# Used when MODEL_PROVIDER=Anthropic. claude-haiku-4-5 is the cheapest current
# model that handles this app's tool calling; claude-sonnet-5 and
# claude-opus-5 are drop-in swaps.
#ANTHROPIC_API_KEY=sk-ant-...
#ANTHROPIC_MODEL=claude-haiku-4-5

# Where blazor-app looks for Ollama. The default points at the Ollama running
# natively on your machine (host.docker.internal is the Docker hostname for
# the host itself), so inference uses your GPU and your already-pulled models.
# Only change this if you run Ollama somewhere else — e.g. `http://ollama:11434`
# if you add the containerized Ollama service back (see docs/BuildGuide.md).
#OLLAMA_ENDPOINT=http://host.docker.internal:11434
