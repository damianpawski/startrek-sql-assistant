{
  "$schema": "https://github.com/Azure/data-api-builder/releases/latest/download/dab.draft.schema.json",
  "data-source": {
    "database-type": "mssql",
    "connection-string": "@env('DATABASE_CONNECTION_STRING')"
  },
  "runtime": {
    "rest": {
      "enabled": true,
      "path": "/api"
    },
    "graphql": {
      "enabled": true,
      "path": "/graphql"
    },
    "mcp": {
      "enabled": true,
      "description": "Query a reference database covering the Star Trek franchise: every TV series, episode, and movie, plus their home-media (DVD/Blu-ray) releases. Prefer the pre-joined entities: EpisodeDetail for episodes with their series name, SeriesSummary for per-show totals and spans, EpisodeOnDisc for which episodes are on which disc. Each answers in one read_records or aggregate_records call what would otherwise take several."
    },
    "host": {
      "mode": "development",
      "cors": {
        "origins": ["*"]
      }
    }
  },
  "entities": {
    "Series": {
      "source": { "object": "dbo.series", "type": "table" },
      "description": "Star Trek television series, one row per show, with its full title, short abbreviation (TOS, TNG, DS9, VOY, ...), and the date it first and last aired.",
      "graphql": { "enabled": true, "type": { "singular": "Series", "plural": "AllSeries" } },
      "relationships": {
        "episodes": {
          "cardinality": "many",
          "target.entity": "Episode",
          "source.fields": [ "series_id" ],
          "target.fields": [ "series_id" ]
        },
        "mediaSets": {
          "cardinality": "many",
          "target.entity": "MediaSet",
          "source.fields": [ "series_id" ],
          "target.fields": [ "series_id" ]
        }
      },
      "permissions": [
        { "role": "anonymous", "actions": ["read"] }
      ]
    },
    "Episode": {
      "source": { "object": "dbo.episode", "type": "table" },
      "description": "Individual episodes across every Star Trek series. series_id links to Series. Includes air date, remastered air date, season, episode number, production code, and stardate.",
      "graphql": { "enabled": true, "type": { "singular": "Episode", "plural": "Episodes" } },
      "relationships": {
        "series": {
          "cardinality": "one",
          "target.entity": "Series",
          "source.fields": [ "series_id" ],
          "target.fields": [ "series_id" ]
        },
        "mediumVolumes": {
          "cardinality": "many",
          "target.entity": "MediumVolume",
          "source.fields": [ "episode_id" ],
          "target.fields": [ "medium_volume_id" ],
          "linking.object": "dbo.medium_volume_episode",
          "linking.source.fields": [ "episode_id" ],
          "linking.target.fields": [ "medium_volume_id" ]
        }
      },
      "permissions": [
        { "role": "anonymous", "actions": ["read"] }
      ]
    },
    "Movie": {
      "source": { "object": "dbo.movie", "type": "table" },
      "description": "The Star Trek feature films, with theatrical release date and stardate. Not linked to Series.",
      "graphql": { "enabled": true, "type": { "singular": "Movie", "plural": "Movies" } },
      "permissions": [
        { "role": "anonymous", "actions": ["read"] }
      ]
    },
    "MediaSet": {
      "source": { "object": "dbo.media_set", "type": "table" },
      "description": "A home-media release set (e.g. 'DVD', 'Blu-ray', 'HD DVD') for one series and season. series_id links to Series.",
      "graphql": { "enabled": true, "type": { "singular": "MediaSet", "plural": "MediaSets" } },
      "relationships": {
        "series": {
          "cardinality": "one",
          "target.entity": "Series",
          "source.fields": [ "series_id" ],
          "target.fields": [ "series_id" ]
        },
        "mediumVolumes": {
          "cardinality": "many",
          "target.entity": "MediumVolume",
          "source.fields": [ "media_set_id" ],
          "target.fields": [ "media_set_id" ]
        }
      },
      "permissions": [
        { "role": "anonymous", "actions": ["read"] }
      ]
    },
    "MediumVolume": {
      "source": { "object": "dbo.medium_volume", "type": "table" },
      "description": "A single disc within a MediaSet. media_set_id links to MediaSet; sequence is the disc number within the set.",
      "graphql": { "enabled": true, "type": { "singular": "MediumVolume", "plural": "MediumVolumes" } },
      "relationships": {
        "mediaSet": {
          "cardinality": "one",
          "target.entity": "MediaSet",
          "source.fields": [ "media_set_id" ],
          "target.fields": [ "media_set_id" ]
        },
        "episodes": {
          "cardinality": "many",
          "target.entity": "Episode",
          "source.fields": [ "medium_volume_id" ],
          "target.fields": [ "episode_id" ],
          "linking.object": "dbo.medium_volume_episode",
          "linking.source.fields": [ "medium_volume_id" ],
          "linking.target.fields": [ "episode_id" ]
        }
      },
      "permissions": [
        { "role": "anonymous", "actions": ["read"] }
      ]
    },
    "EpisodeDetail": {
      "source": { "object": "dbo.episode_detail", "type": "view", "key-fields": [ "episode_id" ] },
      "description": "Every episode with its series' title and abbreviation already attached, plus air_year as a number. Use this instead of Episode whenever a question names a show or a year, e.g. episodes of DS9 season 2, or how many episodes aired in 1995.",
      "graphql": { "enabled": true, "type": { "singular": "EpisodeDetail", "plural": "EpisodeDetails" } },
      "permissions": [
        { "role": "anonymous", "actions": ["read"] }
      ]
    },
    "EpisodeOnDisc": {
      "source": { "object": "dbo.episode_on_disc", "type": "view", "key-fields": [ "medium_volume_episode_id" ] },
      "description": "One row per episode per home-media disc, with the series, media_type (DVD, Blu-ray, ...), set season and disc number already joined. Use this for any question about which disc or set an episode is on, or what is on a disc.",
      "graphql": { "enabled": true, "type": { "singular": "EpisodeOnDisc", "plural": "EpisodesOnDisc" } },
      "permissions": [
        { "role": "anonymous", "actions": ["read"] }
      ]
    },
    "SeriesSummary": {
      "source": { "object": "dbo.series_summary", "type": "view", "key-fields": [ "series_id" ] },
      "description": "One row per series with episode_count, season_count, run_days, begin/end year and first/last episode air date precomputed. Use this for which show has the most episodes or seasons, ran longest, or started in a given year.",
      "graphql": { "enabled": true, "type": { "singular": "SeriesSummary", "plural": "SeriesSummaries" } },
      "permissions": [
        { "role": "anonymous", "actions": ["read"] }
      ]
    },
    "MediumVolumeEpisode": {
      "source": { "object": "dbo.medium_volume_episode", "type": "table" },
      "description": "Join table linking a MediumVolume (disc) to the episodes it contains, via medium_volume_id and episode_id.",
      "graphql": { "enabled": true, "type": { "singular": "MediumVolumeEpisode", "plural": "MediumVolumeEpisodes" } },
      "relationships": {
        "mediumVolume": {
          "cardinality": "one",
          "target.entity": "MediumVolume",
          "source.fields": [ "medium_volume_id" ],
          "target.fields": [ "medium_volume_id" ]
        },
        "episode": {
          "cardinality": "one",
          "target.entity": "Episode",
          "source.fields": [ "episode_id" ],
          "target.fields": [ "episode_id" ]
        }
      },
      "permissions": [
        { "role": "anonymous", "actions": ["read"] }
      ]
    }
  }
}
