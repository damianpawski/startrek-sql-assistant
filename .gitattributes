# Normalize line endings: LF in the repository and in working trees on every
# platform, so a Windows (core.autocrlf=true) and a Linux/macOS checkout
# produce identical diffs. Matches end_of_line in .editorconfig.
* text=auto eol=lf

# Files that run inside Linux containers must stay LF regardless.
*.sh        text eol=lf
*.sql       text eol=lf
Dockerfile  text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf

# Windows-only scripts need CRLF.
*.cmd       text eol=crlf
*.bat       text eol=crlf
*.ps1       text eol=crlf

# Binary assets: never diff or convert.
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.webp      binary
*.woff      binary
*.woff2     binary
*.pdf       binary
