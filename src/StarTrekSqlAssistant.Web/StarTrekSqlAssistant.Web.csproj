<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <UserSecretsId>startrek-sql-assistant</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- MCP client: connects to Data API builder's SQL MCP Server -->
    <PackageReference Include="Anthropic" Version="12.46.0" />
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" Version="10.9.0" />
    <PackageReference Include="ModelContextProtocol" Version="2.2.0" />
    <!-- IChatClient + FunctionInvokingChatClient (automatic tool-call loop) -->
    <PackageReference Include="Microsoft.Extensions.AI" Version="10.9.0" />
    <!-- IChatClient implementation that talks to a local Ollama server -->
    <PackageReference Include="OllamaSharp" Version="5.4.30" />
    <PackageReference Include="OpenAI" Version="2.12.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Traces, metrics and logs. The OTLP exporter is only *registered* when
         Telemetry:OtlpEndpoint is set (see Program.cs), so a plain `dotnet run`
         with nothing listening behaves exactly as it did before OTel existed. -->
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.18.0" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.18.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.18.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" Version="1.18.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" Version="1.18.0" />
  </ItemGroup>

</Project>
