<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- TargetFramework, LangVersion, Nullable, ImplicitUsings and the
       warnings-as-errors settings come from Directory.Build.props; package
       versions come from Directory.Packages.props. -->
  <PropertyGroup>
    <InvariantGlobalization>true</InvariantGlobalization>
    <UserSecretsId>startrek-sql-assistant</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- MCP client: connects to Data API builder's SQL MCP Server -->
    <PackageReference Include="Anthropic" />
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" />
    <PackageReference Include="ModelContextProtocol" />
    <!-- IChatClient + FunctionInvokingChatClient (automatic tool-call loop) -->
    <PackageReference Include="Microsoft.Extensions.AI" />
    <!-- IChatClient implementation that talks to a local Ollama server -->
    <PackageReference Include="OllamaSharp" />
    <PackageReference Include="OpenAI" />
  </ItemGroup>

  <ItemGroup>
    <!-- Traces, metrics and logs. The OTLP exporter is only *registered* when
         Telemetry:OtlpEndpoint is set (see Program.cs), so a plain `dotnet run`
         with nothing listening behaves exactly as it did before OTel existed. -->
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" />
  </ItemGroup>

</Project>
