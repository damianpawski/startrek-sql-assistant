{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Dab": {
    "McpEndpoint": "http://localhost:5000/mcp"
  },
  "Telemetry": {
    "ServiceName": "startrek-sql-assistant",
    "OtlpEndpoint": "",
    "CaptureMessageContent": false
  },
  "Ollama": {
    "Endpoint": "http://localhost:11434",
    "Model": "llama3.1",
    "TimeoutSeconds": 600
  },
  "Model": {
    "Provider": "Ollama"
  },
  "RateLimit": {
    "QuestionsPerMinute": 5,
    "ConcurrentQuestions": 1,
    "PageLoadsPerMinute": 20
  },
  "OpenAI": {
    "ApiKey": "",
    "Model": "gpt-4o-mini",
    "Endpoint": "",
    "TimeoutSeconds": 300
  },
  "Anthropic": {
    "ApiKey": "",
    "Model": "claude-haiku-4-5",
    "MaxOutputTokens": 16000,
    "TimeoutSeconds": 300
  }
}
